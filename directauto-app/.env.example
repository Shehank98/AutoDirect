# ---- PostgreSQL (Railway injects DATABASE_URL when you add a Postgres service) ----
DATABASE_URL=postgres://user:password@localhost:5432/directauto
# Set to true only if connecting over a public/SSL Postgres endpoint.
PGSSL=false

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Photos ----
# Leave unset: sample car photos are shown until Firebase Storage is configured, then uploaded photos are shown.
# true / false forces it either way.
# USE_SAMPLE_IMAGES=

# ---- Live auction page ----
# The page embeds this URL in an iframe. Optional hint text is shown above it (e.g. a guest login).
LIVE_AUCTION_URL=https://jpcenter.ru/on?classic
LIVE_AUCTION_HINT=

# ---- Admin access: owner email(s), comma separated. They become admins on Firebase sign-in
# at /admin ONLY once the email is verified. More staff are added under Admin > Customers. ----
ADMIN_EMAILS=

# ---- Firebase (server-side Admin SDK: verifies logins + uploads images) ----
# Paste the FULL service-account JSON as a single-line string (Project settings ->
# Service accounts -> Generate new private key). Keep the quotes.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ---- Firebase (public web config: used by the browser to sign users in) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Public contact details (shown in the header, footer and Contact page) ----
SITE_PHONE=+94 768 65 65 15
SITE_EMAIL=info@directautoimport.lk
SITE_WHATSAPP=94768656515
SITE_ADDRESS=Malabe showroom · Colombo 07 office
SITE_HOURS=Mon–Sat · 9.00–6.00
SITE_INSTAGRAM=https://www.instagram.com/directautoimport.lk/
# ---- Email alerts to the sales team (the old site did this) ----
# One email for every new quote, viewing, contact message, sell-your-car request, auction request and newsletter signup.
# Leave SMTP_HOST empty to turn alerts off. Use the admin Inquiries page -> "Send test email" to check the settings.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL). Port 587 uses STARTTLS automatically.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Direct Auto <alerts@yourdomain.lk>
# Comma separated. NOTIFY_TO is required; CC and BCC are optional.
NOTIFY_TO=
NOTIFY_CC=
NOTIFY_BCC=

# ---- SEO ----
# Your public address, used in sitemap.xml, canonical links and link previews. Example: https://www.directautoimport.lk
SITE_URL=

# ---- Optional chat + analytics (off when empty; neither loads on /admin) ----
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (the old UA- ids no longer work).
GA_MEASUREMENT_ID=
# Tawk.to live chat property id (the old site used 5a81bf45d7591465c7079938) and widget id.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=default

# ---- CORS (leave empty: the site and API share one origin) ----
# CORS_ORIGIN=https://other-site.example

# ---- Demo data ----
# Set to false in production to skip loading the 7 sample cars into an empty database.
SEED_DEMO_DATA=true
