# ---- PostgreSQL (Railway injects DATABASE_URL when you add a Postgres service) ----
DATABASE_URL=postgres://user:password@localhost:5432/directauto
# Set to true only if connecting over a public/SSL Postgres endpoint.
PGSSL=false

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Admin bootstrap ----
# Comma-separated emails that become admins automatically on first login.
ADMIN_EMAILS=shehan.k98@gmail.com

# ---- Firebase (server-side Admin SDK: verifies logins + uploads images) ----
# Paste the FULL service-account JSON as a single-line string (Project settings ->
# Service accounts -> Generate new private key). Keep the quotes.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ---- Firebase (public web config: used by the browser to sign users in) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
